{
  "schema": "paramorphic-shell/2",
  "base": {
    "schema": "paramorphic-shell/1",
    "layout": "sidebar",
    "title": "",
    "slots": [
      "navigation",
      "content"
    ],
    "widths": [
      1,
      1
    ]
  },
  "morphs": [
    {
      "name": "shell.title",
      "params": {
        "value": "Spreadsheet"
      }
    },
    {
      "name": "shell.layout",
      "params": {
        "value": {
          "layout": "sidebar",
          "slots": [
            "inspector",
            "sheet"
          ],
          "widths": [
            1,
            4
          ]
        }
      }
    },
    {
      "name": "shell.menus",
      "params": {
        "value": [
          {
            "id": "file",
            "label": "File",
            "items": [
              {
                "id": "new",
                "label": "New sheet…",
                "shortcut": "Mod+N"
              },
              {
                "id": "open",
                "label": "Open…",
                "shortcut": "Mod+O"
              },
              {
                "id": "save",
                "label": "Save",
                "shortcut": "Mod+S"
              },
              {
                "id": "reload",
                "label": "Reload file"
              }
            ]
          },
          {
            "id": "edit",
            "label": "Edit",
            "items": [
              {
                "id": "undo",
                "label": "Undo",
                "shortcut": "Mod+Z"
              },
              {
                "id": "redo",
                "label": "Redo",
                "shortcut": "Mod+Shift+Z"
              }
            ]
          },
          {
            "id": "help",
            "label": "Help",
            "items": [
              {
                "id": "about",
                "label": "About"
              }
