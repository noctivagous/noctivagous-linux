      "params": {
        "value": [
          {
            "id": "new",
            "label": "New"
          },
          {
            "id": "open",
            "label": "Open"
          },
          {
            "id": "save",
            "label": "Save"
          },
          {
            "id": "undo",
            "label": "Undo"
          },
          {
            "id": "redo",
            "label": "Redo"
          }
        ]
      }
    },
    {
      "name": "shell.dialogs",
      "params": {
        "value": [
          {
            "id": "about",
            "title": "About Spreadsheet",
            "message": "Edit cells from a morph-plan. Save writes a replayable plan; Open validates it before it becomes a sheet."
          },
          {
            "id": "new",
            "title": "New sheet",
            "message": "Choose dimensions and whether formulas are enabled.",
            "submit": "create",
            "submitLabel": "Create",
            "fields": [
              {
                "id": "width",
                "label": "Columns",
                "type": "integer",
                "min": 1,
                "max": 64,
                "value": 5
              },
              {
                "id": "height",
                "label": "Rows",
                "type": "integer",
                "min": 1,
                "max": 64,
                "value": 4
              },
              {
                "id": "formulas",
                "label": "Formulas",
                "type": "boolean",
                "value": true
              }
            ]
          }
        ]
      }
    },
    {
      "name": "shell.actions",
      "params": {
        "value": [
          {
            "id": "new",
            "do": "dialog.open",
            "target": "new"
          },
          {
            "id": "create",
            "do": "document.new",
            "target": "sheet"
          },
          {
            "id": "open",
            "do": "document.open",
            "target": "sheet"
          },
          {
            "id": "save",
            "do": "document.save",
            "target": "sheet"
          },
          {
            "id": "reload",
            "do": "document.reload",
            "target": "sheet"
          },
          {
            "id": "undo",
            "do": "history.undo",
            "target": "sheet"
          },
          {
            "id": "redo",
