; Engine configuration file.
; It's best edited using the editor UI and not directly.
config_version=5

[application]
config/name="NCT Greeter"
run/main_scene="res://main.tscn"
; Boot handoff (2026-11-28): the engine splash IS used, as the
; continuation of the Plymouth boot splash. Plymouth's last
; frame (logo + full category bars on black) is recreated in
; boot-continuation.png; Godot draws it as its first frame, so
; the Plymouth -> greeter seam shows one continuous image
; instead of a black beat while cage/Godot start. The scene's
; own backdrop tone (0.05) follows when the login form fades
; in. Pure black bg so off-size displays letterbox onto the
; same black Plymouth used.
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=true
boot_splash/image="res://boot-continuation.png"
boot_splash/stretch_mode=1

[display]
window/size/viewport_width=900
window/size/viewport_height=620
; Fullscreen from engine start: without this the window (and the
; boot splash painted into it) starts at the viewport size above
; and only grows to the display once the compositor configure
; lands - a small grey island on black at every boot.
window/size/mode=3

[rendering]
; Match the boot background: no second flash between splash-off and
; the scene's first frame.
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.05, 1)
