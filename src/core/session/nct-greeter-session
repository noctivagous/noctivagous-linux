#!/bin/sh
# nct-greeter-session — the greeter session greetd starts: the auth bridge,
# then a single-app compositor running the Godot greeter fullscreen.
# NCT_GREETER_COMPOSITOR=cage (VM default) or sway (nested tests).
set -eu
# $0 may be a bare name when we are found through PATH (the shell's
# buttons call nct-launch that way): resolve it before dirname.
case $0 in */*) _self=$0 ;; *) _self=$(command -v "$0") ;; esac
here=$(cd "$(dirname "$_self")" && pwd)
src=${NCT_SRC:-$(cd "$here/../.." && pwd)}
export NCT_SRC="$src" PATH="$here:$PATH"
state=${NCT_STATE_DIR:-/tmp/nct-greeter-state}; mkdir -p "$state"; export NCT_STATE_DIR="$state"
# What START starts: under greetd, the full user session (greetd runs it
# as the authenticated user); otherwise (tests) the session-apps stage,
# because a compositor is already running there.
if [ -n "${GREETD_SOCK:-}" ]; then
  export NCT_SESSION_CMD=${NCT_SESSION_CMD:-"$src/core/session/nct-session"}
else
  export NCT_SESSION_CMD=${NCT_SESSION_CMD:-"$src/core/session/nct-session-apps"}
fi
# The bridge: fixture backend unless GREETD_SOCK is present (then greetd).
python3 "$src/services/bridge/nct-greetd-bridge.py" >> "$state/bridge.log" 2>&1 &
bridge_pid=$!
trap 'kill $bridge_pid 2>/dev/null || true' EXIT
greeter_cmd=$("$here/nct-resolve-cmd" greeter)
comp=${NCT_GREETER_COMPOSITOR:-cage}
case "$comp" in
  sway)
    cfg=${NCT_SWAY_GREETER_CONFIG:-$state/sway-greeter.conf}
    printf 'output * resolution 1280x800\ndefault_border none\nexec %s --fullscreen\n' "$greeter_cmd" > "$cfg"
    sway -c "$cfg" ;;
  cage|*)
    # Rendering goes through the fallback ladder (A14): try the native
    # path first (Vulkan/Wayland), step down only when an attempt dies
    # fast. The A13 software configuration is the ladder's bottom rung,
    # reached automatically on stacks like VirtualBox's vmwgfx whose
    # dmabuf import is broken — and remembered, so later boots start
    # there. No exec, and output stays captured in the state dir:
    # under greetd nothing forwards it to the journal, which is the
    # evidence gap behind ASSUMPTION A13.
    . "$here/nct-render-ladder.sh"
    code=0
    ladder_run "$state" cage.log cage -- sh -c "$greeter_cmd --fullscreen" || code=$?
    echo "nct-greeter-session: session ended with code $code" >>"$state/cage.log"
    exit "$code" ;;
esac
