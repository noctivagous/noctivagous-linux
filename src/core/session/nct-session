#!/bin/sh
# nct-session — the user session: compositor + nct-session-apps.
# Compositor: NCT_COMPOSITOR=labwc (default, the stand-in) or sway (tests).
set -eu
# $0 may be a bare name when we are found through PATH (the shell's
# buttons call nct-launch that way): resolve it before dirname.
case $0 in */*) _self=$0 ;; *) _self=$(command -v "$0") ;; esac
here=$(cd "$(dirname "$_self")" && pwd)
src=${NCT_SRC:-$(cd "$here/../.." && pwd)}
export NCT_SRC="$src" PATH="$here:$PATH"
state=${NCT_STATE_DIR:-$HOME/.local/state/nct}; mkdir -p "$state"
comp=${NCT_COMPOSITOR:-labwc}
echo "$(date -Is) session start compositor=$comp" >> "$state/session.log"
case "$comp" in
  sway)
    cfg=${NCT_SWAY_CONFIG:-$state/sway-session.conf}
    printf 'output * resolution 1280x800\ndefault_border none\nexec %s/core/session/nct-session-apps\n' "$src" > "$cfg"
    exec sway -c "$cfg" ;;
  labwc|*)
    cfgdir=${NCT_LABWC_CONFIG:-$src/core/compositor/labwc}
    # The whole session renders under the fallback ladder (A14): the
    # rung environment is exported here, so labwc and everything it
    # autostarts (shell, apps via nct-godot-run) inherit it. Native
    # first; the software rung only when an attempt dies fast.
    # NOTE: labwc has no LABWC_CONFIG_DIR variable — the config dir
    # goes via -C, or labwc runs the empty default config and autostart
    # (which starts the shell) never runs. That silent skip was the
    # run-all 04 failure on the rig.
    . "$here/nct-render-ladder.sh"
    code=0
    ladder_run "$state" session.log labwc -C "$cfgdir" || code=$?
    exit "$code" ;;
esac
