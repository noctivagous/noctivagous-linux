# Vagrantfile — the NCT test VM. See ../VM-RIG.md (living file).
# Host: Windows + VirtualBox 7.x.  Usage:  vagrant up | vagrant ssh | vagrant snapshot save <name>
Vagrant.configure("2") do |config|
  # debian/trixie64 ships libvirt only (no VirtualBox provider), so the
  # Windows/VirtualBox rig uses the Bento Debian 13 box instead (A11 stays
  # intact: still Debian 13/trixie).
  config.vm.box = "bento/debian-13"
  config.vm.box_architecture = "amd64"
  config.vm.hostname = "nct-test"
  # provision.sh, run-all.sh and vm-test.sh all expect the repo root at
  # /vagrant (i.e. /vagrant/src/...), so sync ../.. there instead of this
  # directory (A6).
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "../..", "/vagrant"
  # Vagrant forwards guest 22 to host 2222 by default for ssh.
  config.vm.provider "virtualbox" do |vb|
    vb.name = "nct-test"
    vb.memory = 4096
    vb.cpus = 2
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
    vb.customize ["modifyvm", :id, "--accelerate3d", "on"]
    vb.gui = false # headless; open the VirtualBox GUI yourself when you want eyes on the console
  end
  config.vm.provision "shell", path: "provision.sh"
end
