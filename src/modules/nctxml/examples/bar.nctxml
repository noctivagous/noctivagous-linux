<?xml version="1.0" encoding="utf-8"?>
<!-- The launch bar (E4): a shell-kind NCTXML document. One
     button per launch-list entry, generated by a Repeat over
     the Entries the host supplies; each button's handler
     receives its entry. The clock is a bound label. -->
<shell Id="launch-bar" Name="Launch Bar" RequestedStyle="panel">
  <Panel>
    <Stack Orientation="horizontal">
      <Label Text="  NCT"/>
      <Label Name="ClockLabel" Text="{Clock}"/>
      <Repeat Name="LaunchRepeat" Items="{Entries}" Orientation="horizontal">
        <Button Text="{title}" onPressed="LaunchItem"/>
      </Repeat>
    </Stack>
  </Panel>
</shell>
