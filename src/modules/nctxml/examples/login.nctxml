<?xml version="1.0" encoding="utf-8"?>
<!-- The login screen (E3, restyled in the greeter-look
     slice): an NCTXML view over the login form model. The
     modal is a CARD — a Panel the Center container centers
     as one object, so what is centered on screen is the
     card itself, status row included; the row is reserved
     (fixed minimum height) so the card never jumps when a
     failure lands in it. The backdrop stays scene-side
     (main.gd's ColorRect). -->
<window Model="login.nctform" Title="Log in">
  <Center>
    <Panel Name="LoginCard">
      <Margin MarginLeft="32" MarginRight="32"
              MarginTop="28" MarginBottom="28">
        <Stack Orientation="vertical" Separation="10">
          <Label Name="TitleLabel" Text="NOCTIVAGOUS"
                 HorizontalAlignment="Center"/>
          <TextField Name="UserField" Placeholder="Username"
                     CustomMinimumSize="320, 38"
                     Text="{username, Mode=TwoWay}"
                     onTextSubmitted="OnUserSubmitted"/>
          <TextField Name="PassField" Placeholder="Password" Secret="true"
                     CustomMinimumSize="320, 38"
                     Text="{password, Mode=TwoWay}"
                     onTextSubmitted="OnPasswordSubmitted"/>
          <Button Name="LoginButton" Text="Log In"
                  CustomMinimumSize="320, 42" Submit="attempt"/>
          <Label Name="StatusLabel" Text="{status}"
                 HorizontalAlignment="Center"
                 CustomMinimumSize="0, 20"/>
        </Stack>
      </Margin>
    </Panel>
  </Center>
</window>
