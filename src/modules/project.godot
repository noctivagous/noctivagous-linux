; Engine configuration file.
; It's best edited using the editor UI and not directly.
config_version=5

[application]

config/name="NCT Modules"
run/main_scene="res://nct-window-manager/harness/main.tscn"
; No engine splash (house rule, as in godot/shell).
boot_splash/bg_color=Color(0.137255, 0.137255, 0.160784, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

environment/defaults/default_clear_color=Color(0.137255, 0.137255, 0.160784, 1)

[dotnet]

project/assembly_name="NCTModules"
